# Copia questo file come ".env" e inserisci la tua chiave.
# Il file .env NON va mai caricato su GitHub.
GEMINI_API_KEY=incolla_qui_la_tua_chiave

# Modello Gemma 4: gemma-4-26b-a4b-it (più veloce) oppure gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# 1 = Gemma usa la Ricerca Google per orari/prezzi aggiornati, 0 = no
USE_GOOGLE_SEARCH=1

# 1 = ragionamento attivo (più lento, a volte più preciso)
USE_THINKING=0

# 1 = dati finti, nessuna chiamata all'API (per lavorare sulla grafica)
MOCK_MODE=0

# Richieste all'AI consentite per ogni IP al minuto
RATE_LIMIT_PER_MINUTE=20

# 1 solo online dietro un proxy (es. Render): usa X-Forwarded-For per il limite per IP
TRUST_PROXY=0
